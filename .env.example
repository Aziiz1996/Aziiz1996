# يضاف في Render فقط، ولا يوضع في الواجهة أو GitHub.
OPENAI_API_KEY=sk-your-server-key
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# إعدادات Moodle الاختيارية. القيم الافتراضية مناسبة للرابط الحالي.
MOODLE_BASE_URL=https://lms.ac-seu.com
MOODLE_SERVICE_NAME=moodle_mobile_app

# شرح تيتشر لوجستيك الاختياري؛ المفتاح في الخادم فقط.
OPENAI_TUTOR_MODEL=gpt-4.1-mini
# بريد المالك ورمز التفعيل يضبطان في الاستضافة ولا يوضعان في المستودع.
LEADER_OWNER_EMAIL=
LEADER_OWNER_SETUP_KEY=

# Claude option for Teacher Logistics. Leave blank to keep OpenAI/local mode.
ANTHROPIC_API_KEY=
ANTHROPIC_TUTOR_MODEL=claude-sonnet-4-5
# Optional Saudi cloud speech. Keys are server-only; browser device voice stays available.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Optional SMS verification. Existing email/password login does not require SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Durable application send ceiling for each 24-hour window (all users combined).
TWILIO_DAILY_SEND_LIMIT=100
